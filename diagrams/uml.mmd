flowchart TB
    %% PawPal+ system / architecture diagram
    %% Shows how the project is organized: UI -> core scheduling logic, plus the
    %% RAG AI feature that grounds answers and task suggestions in a knowledge base.
    %% (The detailed class diagram now lives in diagrams/class_diagram.mmd.)

    User([Pet owner])

    subgraph UI["UI layer &mdash; app.py (Streamlit)"]
        Inputs[Owner / Pet / Task inputs]
        AskBox[Ask PawPal care question]
        SuggestBtn[Suggest tasks button]
        PlanView[Schedule + why-this-plan]
    end

    subgraph Core["Core logic &mdash; pawpal_system.py"]
        Domain[Owner / Pet / Task]
        Scheduler[Scheduler]
        DailyPlan[DailyPlan / PlanEntry]
    end

    subgraph RAG["AI feature &mdash; rag.py  (new)"]
        Guard[Guardrails<br/>emergency / off-topic / validation]
        Retriever[TF-IDF retriever]
        Suggest[suggest_tasks]
    end

    KB[("knowledge/*.md<br/>pet-care knowledge base")]
    Log[["pawpal.log<br/>(logging)"]]
    Tests[["tests/ &mdash; pytest"]]

    %% Scheduling flow (unchanged core)
    User --> Inputs
    Inputs --> Domain
    Domain --> Scheduler
    Scheduler --> DailyPlan
    DailyPlan --> PlanView
    PlanView --> User

    %% RAG question-answering flow
    User --> AskBox
    AskBox --> Guard
    Guard --> Retriever
    Retriever --> KB
    Retriever --> AskBox

    %% RAG task-suggestion flow feeds the existing scheduler
    User --> SuggestBtn
    SuggestBtn --> Suggest
    Suggest --> Retriever
    Suggest --> Domain

    %% Cross-cutting concerns
    RAG -. logs .-> Log
    Tests -. verify .-> Core
    Tests -. verify .-> RAG
